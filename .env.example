# Base URL backend Laravel kamu (tanpa trailing slash), diakhiri /api
VITE_API_BASE_URL=http://localhost:8000/api

# Client key Midtrans (Settings > Access Keys di dashboard Midtrans)
# Pakai yang diawali "SB-Mid-client-" untuk sandbox
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# "true" kalau sudah pakai client key production
VITE_MIDTRANS_IS_PRODUCTION=false
